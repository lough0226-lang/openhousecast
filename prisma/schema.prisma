// Prisma schema for OpenHouseCast
// Docs: https://pris.ly/d/prisma-schema
// Application tables live in the dedicated "app" schema so Prisma never touches
// the Supabase-managed tables in "public" (e.g. the platform-owned health_check).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app"]
}

// ---------------------------------------------------------------------------
// NextAuth standard models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  usages       Usage[]
  scripts      Script[]

  @@schema("app")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@schema("app")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("app")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Billing & product models
// ---------------------------------------------------------------------------

enum Plan {
  free
  pro

  @@schema("app")
}

enum SubscriptionStatus {
  active
  inactive

  @@schema("app")
}

model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @unique
  plan                Plan               @default(free)
  status              SubscriptionStatus @default(inactive)
  creemSubscriptionId String?            @unique
  currentPeriodEnd    DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("app")
}

model Usage {
  id     String @id @default(cuid())
  userId String
  month  String // e.g. "2026-10"
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
  @@schema("app")
}

model Script {
  id        String   @id @default(cuid())
  userId    String
  content   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("app")
}
